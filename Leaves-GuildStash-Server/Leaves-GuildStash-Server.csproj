<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Leaves_GuildStash_Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>0.1.0</Version>
    <!-- Build straight into a droppable user/mods/<ModName> layout at the workspace root -->
    <OutputPath>..\..\dist\SPT\user\mods\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
    <!-- LeavesUtils ships as its own separately-installed mod - compile against it, but don't copy
         a private DLL of it (or its own dependency) into this mod's output. -->
    <ProjectReference Include="../../Leaves-LeavesUtil/Leaves-LeavesUtil.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- SPTarkov.Reflection.dll is SPT's own thin wrapper around Harmony (AbstractPatch /
         PatchManager). Reference the DLL shipped with the server; don't bundle a private copy. -->
    <Reference Include="SPTarkov.Reflection">
      <HintPath>G:\Tarkov\SPT-AKI\SPT-4.0.13\SPT\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Build-order dependency on the CLIENT plugin so it is compiled BEFORE the packaging target
         below assembles the combined release zip. ReferenceOutputAssembly=false: this net9 server
         must never link the net472 client DLL; SkipGetTargetFrameworkProperties avoids a cross-TFM
         restore error. Nothing from the client flows into this project - this is purely ordering. -->
    <ProjectReference Include="../Leaves-GuildStash-Client/Leaves-GuildStash-Client.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- config/ids.jsonc is runtime-owned (the live server writes the generated guild-box ids into it
         via IdStore) - excluded so a rebuild never clobbers the live server's populated file with the
         workspace placeholder. Same pattern as ProgressiveContainer/ShinyAirdropGuns; GuildStashItems
         handles a missing file via GetOrCreate, so nothing needs to ship for a fresh install. -->
    <None Include="config\**" Exclude="config\ids.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Web UI page(s) served by GuildStashApi under /guildstash/ui. -->
    <None Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Guild Stash ships as TWO projects - this net9 server AND the net472 client plugin - but as ONE
       download. This target packages both halves into a single release zip laid out from the GAME
       ROOT (the folder that holds both SPT\ and BepInEx\), so a user extracts it once over their
       SPT-4.0.13 folder and both land where they belong:
           SPT\user\mods\Leaves-GuildStash-Server\    (this server mod)
           BepInEx\plugins\Leaves-GuildStash-Client\  (the client plugin)
       The client is guaranteed built first by the build-order ProjectReference above, so its output
       already exists in ..\dist\CLIENT by the time we get here. -->
  <Target Name="CopyToSecondaryLocation" AfterTargets="Build">
    <PropertyGroup>
      <ClientOutDir>$(MSBuildProjectDirectory)\..\..\dist\CLIENT\BepInEx\plugins\Leaves-GuildStash-Client</ClientOutDir>
    </PropertyGroup>
    <ItemGroup>
      <ServerOutputFiles Include="$(OutputPath)**\*.*" />
      <ClientOutputFiles Include="$(ClientOutDir)\**\*.*" />
    </ItemGroup>

    <!-- 1. Purge the ENTIRE previous _dist (old-version zips + staging included) so a version bump
         doesn't leave stale zips behind and removed/renamed files don't stick round -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\_dist"
      Condition="Exists('$(MSBuildProjectDirectory)\_dist')" />

    <!-- 2a. Server half -> SPT\user\mods\<Server> -->
    <Copy SourceFiles="@(ServerOutputFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)\_dist\pack\SPT\user\mods\$(MSBuildProjectName)\%(RecursiveDir)"
      SkipUnchangedFiles="true" />

    <!-- 2b. Client half -> BepInEx\plugins\<Client> -->
    <Copy SourceFiles="@(ClientOutputFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)\_dist\pack\BepInEx\plugins\Leaves-GuildStash-Client\%(RecursiveDir)"
      SkipUnchangedFiles="true" />

    <!-- 3. Zip the CONTENTS of the staging tree (both SPT\ and BepInEx\ sit at the zip root) -->
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\_dist\pack"
      DestinationFile="$(MSBuildProjectDirectory)\Leaves-GuildStash_$(Version).zip"
      Overwrite="true" />

    <!-- 4. Purge the loose staging folder, leaving only the zip -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\_dist\pack" />

    <!-- 5. Move the finished zip into _dist -->
    <Move SourceFiles="$(MSBuildProjectDirectory)\Leaves-GuildStash_$(Version).zip"
      DestinationFiles="$(MSBuildProjectDirectory)\_dist\Leaves-GuildStash_$(Version).zip" />
  </Target>
</Project>