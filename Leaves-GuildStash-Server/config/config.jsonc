{
    // false = mod no go
    "enabled": true,

    // Verbose logging
    "debug": true,

    // The base containers that can become guild stashes. Each becomes a closed + open custom item.
    "boxes": [ //DONT TOUCH/FUCK WITH THIS IF YOU HAVE A RUN IN PROGRESS. ADDING NEW ONES IS ALWAYS FINE.
        {
            "key": "itemcase",
            "cloneFrom": "59fb042886f7746c5005a7b2", // Item case
            "name": "Guild Item Case",
            "shortName": "Guild Case",
            "overrideFilter": true, // hold everything (except other guild cases, always blacklisted)
            "closedColor": "red",   // grid colour when closed
            "openColor": "green",   // grid colour when open
            "width": 2,             // outer footprint (cells); Can be remove and it'll keep the base size. NEVER EVER EVER EVER make it bigger than the original. This will break things in ways I can't even.
            "height": 2
        },
        {
            "key": "thicc", 
            "cloneFrom": "5c0a840b86f7742ffa4f2482", // T H I C C item case
            "name": "Guild THICC Item Case",
            "shortName": "Guild THICC",
            "overrideFilter": true,
            "closedColor": "red",
            "openColor": "green",
            "width": 2,
            "height": 2
        }
    ],

    // Seconds to wait after a player's websocket drops before closing their open boxes (alt-F4 or crash).
    // The delay is load-bearing: the websocket ALSO drops during normal play. Recommended to not go below default 60. But can be increased on very unsteady connections 
    // 0 Disables rather than no grace time.
    "wsDisconnectGraceSeconds": 60,

    // Stock every closed guild box at a trader, cheap (they do nothing without a remote).
    // loyalty level 1, 1 GP coin.
    "closedBoxSale": {
        "enabled": true,
        "trader": "6617beeaa9cfa777ca915b7c",   // Ref ("Arena")
        "currency": "5d235b4d86f7742e017bc88a",  // GP coin
        "price": 1,
        "loyaltyLevel": 1
    }
}
