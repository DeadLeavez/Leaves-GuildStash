{
    // Master switch. false = the mod loads but wires up nothing.
    "enabled": true,

    // Verbose logging for guild-box actions (open/close/convert deltas, tag-drift warnings).
    "debug": true,

    // The base containers that can become guild stashes. Each becomes a closed + open custom item.
    //
    // !!! LIVE SINCE 2026-08-26 - THESE KEYS ARE FROZEN !!!
    // "key" is the id-store key that mints the item tpls ("<key>_closed" / "<key>_open"), and real players
    // on the live server now own boxes built from them. Renaming a key mints NEW ids, which turns every
    // owned box into an unknown item and takes its contents with it. It would also break box-type matching,
    // since each storage records its key as "boxKey".
    // Do NOT rename a key. Do NOT remove a box anyone owns. Do NOT delete or regenerate config/ids.jsonc.
    // Adding a NEW box with a NEW key is safe.
    "boxes": [
        {
            "key": "itemcase",
            "cloneFrom": "59fb042886f7746c5005a7b2", // Item case
            "name": "Guild Item Case",
            "shortName": "Guild Case",
            "overrideFilter": true, // hold everything (except other guild cases, always blacklisted)
            "closedColor": "red",   // grid colour when closed
            "openColor": "green",   // grid colour when open
            "width": 2,             // outer footprint (cells); null/omitted = leave base size
            "height": 2
        },
        {
            "key": "thicc",
            "cloneFrom": "5c0a840b86f7742ffa4f2482", // T H I C C item case
            "name": "Guild THICC Item Case",
            "shortName": "Guild THICC",
            "overrideFilter": true,
            "closedColor": "red",
            "openColor": "green",
            "width": 2,
            "height": 2
        }
    ],

    // Mark OPEN boxes "IsUnremovable" so the client won't even offer to discard one. The server already
    // refuses the discard, but only with a warning the player can dismiss with ESC (leaving a ghost box).
    //
    // KILL SWITCH: closing a box works by telling the client to REMOVE the open box. This flag is believed
    // to restrict PLAYER actions only, not server-pushed changes - but if that's wrong, Close stops working.
    // If closing ever breaks, set this to false and restart before anything else.
    "openBoxUnremovable": true,

    // Seconds to wait after a player's websocket drops before closing their open boxes (alt-F4 / crash).
    // The delay is load-bearing: the websocket ALSO drops during normal play (1s after deploying into a
    // raid, and in the menu with a ~5s reconnect), so closing immediately would rip a box away from someone
    // actively using their stash. We only close if they're still gone when the timer expires. Expiring
    // mid-raid is harmless - raid start already closed everything. 0 disables the hook.
    "wsDisconnectGraceSeconds": 60,

    // Stock every closed guild box at a trader, cheap (they do nothing without a remote). Default: Ref,
    // loyalty level 1, 1 GP coin.
    "closedBoxSale": {
        "enabled": true,
        "trader": "6617beeaa9cfa777ca915b7c",   // Ref ("Arena")
        "currency": "5d235b4d86f7742e017bc88a",  // GP coin
        "price": 1,
        "loyaltyLevel": 1
    }
}
